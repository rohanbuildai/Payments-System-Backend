{
  "name": "@payment-gateway/merchant-service",
  "version": "1.0.0",
  "private": true,
  "description": "Merchant Service for the distributed payment gateway",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --require ./tests/setup.js --test tests/unit/merchant/merchant.validator.test.js tests/unit/merchant/merchant.service.test.js tests/unit/merchant/merchant.controller.test.js tests/unit/api/api-key-generator.test.js tests/unit/api/api-key.repository.test.js tests/unit/api/api-key.service.test.js tests/unit/api/api-key.controller.test.js tests/unit/api/api-key.validation.test.js",
    "test:integration": "node --test --test-concurrency=1 --require ./tests/setup.js tests/integration/merchant.integration.test.js tests/integration/api-key.integration.test.js",
    "db:migrate:create": "node-pg-migrate create --migrations-dir src/database/migrations --migration-file-language sql --migration-filename-format index",
    "db:migrate:up": "node-pg-migrate up --migrations-dir src/database/migrations --database-url-var MERCHANT_DATABASE_URL --envPath ../../.env --migrations-table merchant_service_migrations",
    "db:migrate:down": "node-pg-migrate down --migrations-dir src/database/migrations --database-url-var MERCHANT_DATABASE_URL --envPath ../../.env --migrations-table merchant_service_migrations",
    "db:migrate:test:up": "node-pg-migrate up --migrations-dir src/database/migrations --database-url-var MERCHANT_TEST_DATABASE_URL --envPath ../../.env --migrations-table merchant_service_migrations",
    "db:migrate:test:down": "node-pg-migrate down --migrations-dir src/database/migrations --database-url-var MERCHANT_TEST_DATABASE_URL --envPath ../../.env --migrations-table merchant_service_migrations"
  },
  "dependencies": {
    "@payment-gateway/config": "1.0.0",
    "@payment-gateway/logger": "1.0.0",
    "@payment-gateway/service-runtime": "1.0.0",
    "argon2": "^0.45.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@payment-gateway/testing": "1.0.0",
    "node-pg-migrate": "^9.0.0"
  }
}
